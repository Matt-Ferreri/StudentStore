# Project URL from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key. The site uses this on the server to read listings.
# It cannot insert or upload, because row level security only allows public reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key. Server-only. Never expose this in client code or commit it.
# Posting a listing uses this key inside a Next.js server action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
