# Project URL from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key. The site uses this on the server to read listings.
# It cannot insert or upload, because row level security only allows public reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key. Server-only. Never expose this in client code or commit it.
# Wishlist match emails use this key to read other students' wishes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail account that sends login codes and wishlist match emails.
# Use an App Password, not the normal Gmail password.
# Supabase reads these when it starts. The Next.js server reads them when a listing is posted.
# Do not commit the real values.
SMTP_USER=studentstore.marist@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
